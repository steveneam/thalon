# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
dist/
build/
out/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Environment / secrets (NEVER commit real secrets)
.env
.env.*
!.env.example

# Deploy tooling
.vercel
.render

# Local eval / trace artifacts
.langfuse/
promptfoo-output/
*.trace.json
# Exported eval datasets are DERIVED from the db (regenerate any time);
# only the golden seed is committed.
eval/datasets/

# Dev-seam data (sqlite db + local object store)
.data/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log

# Personal agent-harness settings (per-machine; never committed)
.claude/settings.local.json
# Editor/harness backup droppings of settings files — carry local paths and
# split token fragments; must never be stageable
.claude/*.bak

# Claude Code worktrees (parallel lanes — see COORDINATION.md)
.claude/worktrees/

# ---------------------------------------------------------------------------
# Vault pointer — MUST stay gitignored.
# .context/ points at the read-only research vault whose absolute path itself
# contains a forbidden upstream brand token. Keeping it untracked is what lets
# the CI grep guard (scripts/ci-grep-guard.ps1) pass over tracked files while
# the local build agent still has its vault context. Do NOT remove this line.
# ---------------------------------------------------------------------------
.context/

# a SYMLINK named node_modules (worktree lane prep) is not matched by "node_modules/" — pin both forms
node_modules
