# Personal agent-harness settings (per-machine; never committed)
.claude/settings.local.json
# Editor/harness backup droppings of settings files — carry local paths and
# split token fragments; must never be stageable
.claude/*.bak

# Claude Code worktrees (parallel lanes — see COORDINATION.md)
.claude/worktrees/

# ---------------------------------------------------------------------------
# Local operator context — MUST stay gitignored.
# .context/ holds the vault pointer AND real secrets: dev database credentials,
# tenant profile JSON, client instantiations, operator runbooks. The brand-token
# rationale for ignoring it was retired with the grep guard (2026-07-26, founder
# call); the SECRETS rationale is the one that always mattered and it stands.
# Do NOT remove this line.
# ---------------------------------------------------------------------------
.context/

# a SYMLINK named node_modules (worktree lane prep) is not matched by "node_modules/" — pin both forms
node_modules
