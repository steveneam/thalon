# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
dist/
build/
out/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Environment / secrets (NEVER commit real secrets)
.env
.env.*
!.env.example

# Deploy tooling
.vercel
.render

# Local eval / trace artifacts
.langfuse/
promptfoo-output/
*.trace.json
# Exported eval datasets are DERIVED from the db (regenerate any time);
# only the golden seed is committed.
eval/datasets/

# Dev-seam data (sqlite db + local object store)
.data/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log

# Personal agent-harness settings (per-machine; never committed)
.claude/settings.local.json
# Editor/harness backup droppings of settings files — carry local paths and
# split token fragments; must never be stageable
.claude/*.bak

# Claude Code worktrees (parallel lanes — see COORDINATION.md)
.claude/worktrees/

# ---------------------------------------------------------------------------
# Local operator context — MUST stay gitignored.
# .context/ holds the vault pointer AND real secrets: dev database credentials,
# tenant profile JSON, client instantiations, operator runbooks. The brand-token
# rationale for ignoring it was retired with the grep guard (2026-07-26, founder
# call); the SECRETS rationale is the one that always mattered and it stands.
# Do NOT remove this line.
# ---------------------------------------------------------------------------
.context/

# a SYMLINK named node_modules (worktree lane prep) is not matched by "node_modules/" — pin both forms
node_modules

# ---------------------------------------------------------------------------
# Consolidated from apps/web/.gitignore + infra/.gitignore (s87 hygiene audit,
# founder ask: ONE gitignore). Patterns are repo-wide; all were app-scoped.
# ---------------------------------------------------------------------------
# next.js dev-mode distDir (apps/web/next.config.ts sets distDir=.next-dev in dev)
.next-dev/
# test coverage output
coverage/
# typescript incremental state + Next's generated env types
*.tsbuildinfo
next-env.d.ts
# local certs
*.pem
# yarn/pnp leftovers (scaffold hygiene; npm is the package manager of record)
.pnp.*
.yarn/
# debug logs beyond *.log (npm/yarn/pnpm name variants)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# CDK synth output (infra/)
cdk.out/
