# Thalon web — environment template. Copy to .env.local and fill in what you use.
# PLACEHOLDERS ONLY — never commit real secrets.
#
# Dev needs NOTHING set: the seams default to embedded Postgres (PGlite) +
# local object store + inline queue + a dev auth stub, all zero-cloud.

# --- AI gateway (this project's OWN key; required for generation from Sprint 1) ---
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=                       # only if self-routed

# --- Model tiers (optional overrides; defaults in packages/platform/src/gateway.ts) ---
# MODEL_DRAFT=meta/llama-3.3-70b
# MODEL_JUDGE_SCREEN=meta/llama-3.3-70b
# MODEL_JUDGE_FINAL=anthropic/claude-sonnet-4.5
#
# DEV-ONLY: a `claude-cli/<alias>` tier routes through the local Claude Code
# CLI (operator's subscription, no gateway credits) — build/test phase only,
# never production. Embeddings cannot use this transport.
# MODEL_JUDGE_FINAL=claude-cli/sonnet

# --- Database seam: unset = embedded Postgres (PGlite) at .data/pg/ ---
# Set for Aurora Postgres (driver lands with B0.5):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/thalon

# --- Object store seam: local (default) | s3 ---
# OBJECT_STORE=local
# S3 driver (OBJECT_STORE=s3): bucket + region are REQUIRED — a missing one
# fails loud at first use; there is NO fallback to local. AWS credentials ride
# the standard chain (env / shared profile / instance role) — never put them
# here, never in any tracked file. Ops notes: docs/OBJECT-STORE-S3.md
# S3_BUCKET=
# S3_REGION=
# S3_PREFIX=            # optional key prefix inside the bucket (e.g. staging)
# S3_ENDPOINT=          # optional MinIO/R2-compatible endpoint (implies path-style)

# --- Queue seam: inline (default) | sqs (driver lands Sprint 3+) ---
# QUEUE_DRIVER=inline

# --- Auth seam: leave unset for the dev operator stub; set BOTH to enable Clerk ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# CLERK_SECRET_KEY=sk_test_REPLACE_ME

# --- Eval stack tracing (Langfuse self-host; see eval/README.md).
#     Both keys set => the `tracing` seam reports configured; traces attach
#     at the gateway wrapper from B1.1. ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3001

# --- Where the dev seams keep their files (embedded db + objects) ---
# THALON_DATA_DIR=.data

# --- Per-tenant daily token budget (usage_ledger hard cap; amendment A2) ---
# TENANT_DAILY_TOKEN_BUDGET=2000000

# --- B6.7 deploy (ADR 0007) — production runtime env on the box ---
# Workspace basic-auth gate (`user:password`). Unset in dev = open dev stub;
# unset in PRODUCTION = the workspace fails CLOSED (503). Landing + /blog +
# feeds + health + waitlist stay public either way.
# WORKSPACE_BASIC_AUTH=operator:REPLACE_ME
# Bearer token the box's pre-backup step presents to POST /api/admin/db-dump
# (writes <THALON_DATA_DIR>/backups/pglite-dump.tar.gz). Unset = hook 503s.
# DB_DUMP_TOKEN=REPLACE_ME
# NOTE: NEXT_PUBLIC_SITE_URL is BUILD-time (inlined by Next) — it is a
# Dockerfile.web build arg, not runtime env.
