# Preview gallery: static template-portfolio sites (scaffolding contract:
# proprietary/templates/README.md). Built ONLY by templates-image.yml
# (no-Docker rule on the dev machine). Docroot = sites/<slug>/ plus the
# neutral root index — nothing else from proprietary/ may be copied here
# (the leak boundary: factory method docs never reach a prospect-visible
# host).
FROM node:22-alpine AS catalog
WORKDIR /build
COPY proprietary/templates/sites/ sites/
COPY scripts/build-sites-catalog.mjs .
# W-sites (s61): /catalog.json travels WITH the sites — the workspace's
# remote read (lib/sites provider) fetches it from this image's origin.
RUN node build-sites-catalog.mjs sites catalog.json

FROM nginx:1.27-alpine

COPY proprietary/templates/_preview/nginx.conf /etc/nginx/conf.d/default.conf
COPY proprietary/templates/_preview/index.html /usr/share/nginx/html/index.html
COPY proprietary/templates/sites/ /usr/share/nginx/html/
COPY --from=catalog /build/catalog.json /usr/share/nginx/html/catalog.json
