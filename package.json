{
  "name": "thalon",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone, generic, multi-tenant content and social-automation engine",
  "workspaces": [
    "apps/*",
    "packages/*",
    "proprietary/*",
    "eval"
  ],
  "scripts": {
    "preinstall": "node scripts/guard-worktree-install.mjs",
    "worktree:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/worktree-setup.ps1",
    "dev": "npm run dev -w @thalon/web",
    "build": "npm run build -w @thalon/web",
    "start": "npm run start -w @thalon/web",
    "lint": "eslint . && npm run lint -w @thalon/web",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w @thalon/db",
    "doctor": "node scripts/doctor.mjs",
    "guard": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ci-grep-guard.ps1",
    "guard:pwsh": "pwsh -NoProfile -File scripts/ci-grep-guard.ps1",
    "verify": "npm run guard:pwsh && npm test && npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20",
    "eslint": "^10.6.0",
    "typescript": "^5",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
